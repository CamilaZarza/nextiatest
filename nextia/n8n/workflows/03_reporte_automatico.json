      "name": "Ejecutar a mano (demo)"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8000/resultados",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        200
      ],
      "id": "df38df89-bf71-4ac4-b4c0-93ec24a474c5",
      "name": "Pedir resultados (API)",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Reglas simples del reporte: candidatos destacados = score de 80 o más.\nconst resultados = $input.all().map(i => i.json).filter(r => r.score !== undefined);\nconst destacados = resultados\n  .filter(r => r.score >= 80)\n  .map(r => ({ estudiante: r.estudiante, oferta: r.oferta, score: r.score }));\n\nconst resumen = destacados.length > 0\n  ? `Se analizaron ${resultados.length} compatibilidades. ${destacados.length} con score de 80 o más: ` +\n    destacados.map(d => `${d.estudiante} para \"${d.oferta}\" (${d.score})`).join(\"; \") + \".\"\n  : `Se analizaron ${resultados.length} compatibilidades y ninguna alcanzó 80 puntos.`;\n\nreturn [{ json: { total: resultados.length, destacados, hay_destacados: destacados.length > 0, resumen } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        200
      ],
      "id": "83c4cc8b-3f5c-4fb4-b55f-0eceac4fd374",
      "name": "Armar resumen"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "02c78cc9-34a7-4efa-9a06-765b6294f655",
              "leftValue": "={{ $json.hay_destacados }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        200
      ],
      "id": "741bf05b-4710-4453-a664-96cb4b289807",
      "name": "¿Hay candidatos destacados?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/reportes",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ titulo: 'Reporte de candidatos destacados', resumen: $json.resumen, total_resultados: $json.total, destacados: $json.destacados }) }}"
