      ],
      "id": "d23e8236-62f5-4042-bf17-b6bc1a1868c1",
      "name": "¿Score menor a 70?"
    },
    {
      "parameters": {
        "jsCode": "// Armamos el pedido para la IA con los datos calculados por las reglas de Python.\nconst MODELO = \"gemini-2.5-flash\"; // Cambiar acá si ese modelo no tiene cuota gratuita en tu AI Studio\nconst r = $input.first().json.body;\nconst faltantes = (r.competencias_faltantes || []).join(\", \") || \"ninguna\";\nconst obligatorias = (r.faltantes_obligatorias || []).join(\", \") || \"ninguna\";\n\nconst prompt = `Sos un orientador académico y laboral para estudiantes universitarios argentinos.\nDatos calculados por el sistema (no los cuestiones):\n- Estudiante: ${r.estudiante}\n- Oferta laboral: ${r.oferta}\n- Compatibilidad: ${r.score} sobre 100\n- Competencias que le faltan: ${faltantes}\n- Requisitos obligatorios que le faltan: ${obligatorias}\n\nEscribí entre 3 y 5 recomendaciones breves y concretas para mejorar el perfil (qué practicar o estudiar y por dónde empezar).\nReglas: respondé en español, en texto plano con viñetas simples (guiones), sin títulos.\nNo inventes cursos, instituciones, links ni certificaciones específicas. No prometas resultados laborales.`;\n\nreturn [{ json: { modelo: MODELO, prompt } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        80
      ],
      "id": "09879919-02f8-4955-83d3-bcc7202e6b4c",
      "name": "Armar prompt"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $json.modelo }}:generateContent",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }] }], generationConfig: { temperature: 0.4, maxOutputTokens: 1024 } }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        80
      ],
      "id": "86d04218-6d3f-430f-83f8-5e72af8dde15",
      "name": "Consultar Gemini",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Sacamos el texto de la respuesta de la IA. Si falló o vino vacía, texto queda vacío.\nconst respuesta = $input.first().json;\nconst texto = (respuesta?.candidates?.[0]?.content?.parts?.[0]?.text ?? \"\").trim();\nconst base = $('Webhook').first().json.body;\nconst modelo = $('Armar prompt').first().json.modelo;\nreturn [{ json: { texto, resultado_id: base.id, modelo } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        80
      ],
      "id": "662071e7-4b4c-463f-835b-1fc6f0d3f9ad",
      "name": "Extraer texto"
    },
